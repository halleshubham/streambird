# Postgres
DATABASE_URL=postgres://streambird:streambird@localhost:5432/streambird

# App
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# Transactional email (magic-code login). Unset outside production -- login
# codes are logged to the console instead of sent (see FakeEmailService).
RESEND_API_KEY=
EMAIL_FROM=StreamBird <login@streambird.shackyapps.in>

# Encryption: 32-byte key, base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY_BASE64=

# Which RelayProvider RelayModule wires up: "cloudflare" (default) or "mux".
# Switching this (and redeploying) is the whole failover story for a
# Cloudflare Stream outage -- no code change needed. The browser host
# studio's WHIP publish is unaffected either way -- it always goes through
# our own MediaMTX instance (see MEDIAMTX_* below), which forwards RTMP to
# whichever provider is active, since neither provider's own WHIP ingest
# (Cloudflare's is broken for downstream transcoding, Mux has none at all)
# can be used directly.
RELAY_PROVIDER=cloudflare

# Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# The "customer-<code>" subdomain Stream serves playback from for this
# account, e.g. "0iiq2khjbgvyjw1u" from
# https://customer-0iiq2khjbgvyjw1u.cloudflarestream.com/<uid>/iframe --
# fixed per account, found in any existing playback URL from the dashboard.
CLOUDFLARE_CUSTOMER_CODE=

# Mux Video (alternative relay provider -- see RELAY_PROVIDER above)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Self-hosted MediaMTX -- the universal WHIP front-door for the browser host
# studio (see MediaMtxService for why this exists at all). API URL is
# container-to-container only (Coolify's internal Docker network), never
# public; WHIP base URL is the public domain MediaMTX's WebRTC/HTTP server
# is exposed on.
MEDIAMTX_API_URL=http://streambird-mediamtx:9997
MEDIAMTX_API_USER=
MEDIAMTX_API_PASSWORD=
MEDIAMTX_WHIP_BASE_URL=

# Platform OAuth (filled in as each adapter is built)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
