# Postgres
DATABASE_URL=postgres://streambird:streambird@localhost:5432/streambird

# App
PORT=3000

# Encryption: 32-byte key, base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY_BASE64=

# Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Platform OAuth (filled in as each adapter is built)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
