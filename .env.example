# Postgres
DATABASE_URL=postgres://streambird:streambird@localhost:5432/streambird

# App
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Old hostnames that still reach the app after moving to a new domain
# (comma-separated, no scheme). Page visits on them 301-redirect to
# PUBLIC_BASE_URL (guest links already emailed keep working) and their
# browser writes still pass the CSRF origin check. /api, /health and
# websockets are never redirected. Leave empty when there is no old domain.
LEGACY_HOSTS=
NODE_ENV=development

# Transactional email (magic-code login). Unset outside production -- login
# codes are logged to the console instead of sent (see FakeEmailService).
RESEND_API_KEY=
EMAIL_FROM=StreamBird <login@streambird.app>

# Encryption: 32-byte key, base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY_BASE64=

# RelayProvider is entirely optional -- platform destinations (Twitch etc.)
# are always reached by MediaMTX forwarding RTMP directly to each one's own
# ingest (see MEDIAMTX_* below and MediaMtxService), never through a
# RelayProvider. A RelayProvider is only used, additionally, for its own
# value-add (hosted preview, recording) -- and only when its own credentials
# below are actually filled in (see RelayProvider.isConfigured()). Leave
# both Cloudflare and Mux blank to run with MediaMTX as the only relay.
#
# RELAY_PROVIDER picks which implementation to use *if* one is configured:
# "cloudflare" (default) or "mux". Switching this (and redeploying) is the
# whole failover story for a Cloudflare Stream outage -- no code change
# needed.
RELAY_PROVIDER=cloudflare

# Cloudflare Stream (optional -- see above)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# The "customer-<code>" subdomain Stream serves playback from for this
# account, e.g. "0iiq2khjbgvyjw1u" from
# https://customer-0iiq2khjbgvyjw1u.cloudflarestream.com/<uid>/iframe --
# fixed per account, found in any existing playback URL from the dashboard.
CLOUDFLARE_CUSTOMER_CODE=

# Mux Video (alternative optional relay provider -- see RELAY_PROVIDER above)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Self-hosted MediaMTX -- the universal WHIP front-door for the browser host
# studio (see MediaMtxService for why this exists at all). Both URLs are
# public domains pointed at MediaMTX's two different ports (Control API and
# WebRTC/WHIP HTTP server respectively) -- container-to-container Docker
# networking between separate Coolify apps did not work in practice here,
# so the Control API is instead exposed on its own domain and locked down
# with MediaMTX's own Basic Auth (authInternalUsers, api-only permission).
MEDIAMTX_API_URL=https://mtxapi.example.com
MEDIAMTX_API_USER=
MEDIAMTX_API_PASSWORD=
MEDIAMTX_WHIP_BASE_URL=https://whip.example.com
# "Technical difficulties" slate shown to viewers (up to 5 minutes) if the host
# drops without pressing End stream. MediaMTX's ffmpeg fetches this image over
# HTTP(S), so it must be publicly reachable. Defaults to
# ${PUBLIC_BASE_URL}/glitch-slate.png (served from web-app/public).
# GLITCH_SLATE_URL=

# Platform OAuth (filled in as each adapter is built). YouTube has no
# YOUTUBE_CLIENT_ID/SECRET of its own -- it's the SAME Google OAuth client
# as GOOGLE_CLIENT_ID/SECRET below, just a different scope/redirect URI
# (see GOOGLE_YOUTUBE_REDIRECT_URI).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Superadmin -- a fixed operator identity, seeded/reconciled on every boot
# (SuperadminSeedService), NOT created through the normal signup/magic-code
# flow. Real password login at POST /api/auth/superadmin-login. Leave both
# unset in an environment that doesn't need one (e.g. a throwaway local
# DB) -- seeding is skipped rather than erroring. Changing
# SUPERADMIN_PASSWORD and redeploying rotates the password on next boot;
# it is re-hashed (scrypt, see src/auth/password.util.ts) and stored, never
# kept in plaintext. If SUPERADMIN_EMAIL collides with a pre-existing,
# non-superadmin user, seeding refuses to promote that user and logs a
# warning -- change SUPERADMIN_EMAIL or remove that user first.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Google OAuth login ("Sign in with Google" on the login page, alongside
# magic-code login -- see GoogleOAuthService). Create an OAuth 2.0 Client
# ID (type: Web application) in Google Cloud Console; GOOGLE_REDIRECT_URI
# must be added there verbatim as an authorized redirect URI, and must
# equal `${PUBLIC_BASE_URL}/api/auth/google/callback`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# YouTube platform connect ("Connect YouTube" on the Connections page --
# see YouTubeProvider / PlatformConnectionsController). Same Google OAuth
# client as above, but requires the sensitive `youtube` scope, which
# needs its OWN registered redirect URI in Google Cloud Console (Google
# treats each redirect URI as its own OAuth flow) and submitting the
# OAuth consent screen for Google's verification review before more than
# ~100 test users can use it.
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/platform-connections/youtube/callback
